{
  "name": "Lumina Fusion Tokens",
  "spec": "v0.2",
  "updated": "2026-08-29",
  "principle": "Abstract hierarchy, density, material placement, and motion restraint. On Windows the product must look like Windows. Do not clone Apple or Samsung assets.",
  "color": {
    "accent": { "id": "dawn-bronze", "value": "#C4A574" },
    "bgDark": { "id": "night-navy", "value": "#1B2430" },
    "bgLight": { "id": "ivory-paper", "value": "#F7F1E8" },
    "fgDark": { "value": "#E8E2D6" },
    "fgLight": { "value": "#1B2430" },
    "mutedDark": { "value": "#9A9286" },
    "mutedLight": { "value": "#5C564C" },
    "danger": { "value": "#C45C4A", "usage": "Safety Center warnings only" },
    "ok": { "value": "#6B8F71", "usage": "job succeeded; never a fake security badge" }
  },
  "material": {
    "appBackground": { "windows": "Mica | MicaAlt", "fallback": "solid night-navy or ivory-paper" },
    "transient": { "windows": "Acrylic", "usage": "menus, flyouts, sheets only" },
    "modalScrim": { "windows": "Smoke" },
    "content": { "windows": "Solid opaque", "rule": "lists and preview panes are never glass" },
    "transparencyMode": ["System", "Tinted", "Solid"],
    "defaultTransparency": "Tinted",
    "accessibilityOverride": ["ReduceTransparency", "HighContrast", "AnimationsOff"]
  },
  "radius": {
    "window": 18,
    "card": 12,
    "chip": 999
  },
  "type": {
    "bodyDesktopPx": 14,
    "families": {
      "windows": ["Segoe UI Variable", "Segoe UI"],
      "previewDashboard": ["Source Serif 4", "Pretendard", "Segoe UI"]
    }
  },
  "motion": {
    "sheetMs": [240, 280],
    "respect": "Windows.UI.ViewManagement.UISettings.AnimationsEnabled"
  },
  "density": {
    "desktopListRowPx": 36,
    "touchMinDp": 48
  }
}
