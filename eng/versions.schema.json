{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lumina versions lock",
  "type": "object",
  "required": ["spec", "updated", "product", "toolchains", "dependencies"],
  "properties": {
    "spec": { "type": "string" },
    "updated": { "type": "string" },
    "product": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "channel": { "type": "string" }
      }
    },
    "toolchains": { "type": "object" },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "version", "role", "license", "upstream"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "role": { "type": "string" },
          "license": { "type": "string" },
          "upstream": { "type": "string" },
          "sha256": { "type": "string" },
          "modified": { "type": "boolean" },
          "optional": { "type": "boolean" }
        }
      }
    }
  }
}
